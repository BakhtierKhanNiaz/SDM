{
  "manifest_version": 3,
  "name": "SDM: Download with SDM",
  "version": "1.0.1",
  "key": "",
  "description": "Sends your downloads to SDM on this computer (you can turn this off), and adds \"Download with SDM\" to the right-click menu of links and players.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SDM",
    "default_popup": "popup.html"
  }
}
