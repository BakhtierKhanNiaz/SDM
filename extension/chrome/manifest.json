{
  "manifest_version": 3,
  "name": "SDM: Download with SDM",
  "version": "1.2.1",
  "key": "",
  "description": "Sends your downloads to SDM on this computer (you can turn this off), adds \"Download with SDM\" for links and players, and \"Download this video with SDM\" for video pages.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/sdm-16.png",
    "32": "icons/sdm-32.png",
    "48": "icons/sdm-48.png",
    "128": "icons/sdm-128.png"
  },
  "action": {
    "default_title": "SDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/sdm-16.png",
      "32": "icons/sdm-32.png"
    }
  }
}
