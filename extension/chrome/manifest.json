{
  "manifest_version": 3,
  "name": "SDM: Download with SDM",
  "version": "1.0.0",
  "key": "",
  "description": "Adds \"Download with SDM\" to the right-click menu of links and players, and can send your downloads to SDM on this computer (off until you turn it on).",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SDM",
    "default_popup": "popup.html"
  }
}
